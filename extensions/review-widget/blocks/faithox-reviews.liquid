<script>
(function() {
  function initFaithoxWidget() {
    // 1. Safety Net: If Shopify hasn't loaded Supabase yet, retry in 100ms
    if (!window.supabase) {
      setTimeout(initFaithoxWidget, 100);
      return;
    }

    const productId = "{{ product.id }}";
    const blockId = "{{ block.id }}";
    const fallbackTitle = {{ product.title | json }};
    const fallbackDomain = {{ shop.domain | json }};
    const list = document.getElementById(`widget-reviews-list-${blockId}`);
    let widgetReviewsCount = 0;

    if (!productId) {
      if (list) {
        list.innerHTML = "<div class='faithox-empty-state' style='color:#ef4444; font-weight: 600;'>Error: Product ID missing.</div>";
      }
      return;
    }

    // Carousel Global Functions (Matches company.html 390px card step)
    window.scrollWidgetReviews = function(direction, bId) {
      const carousel = document.getElementById(`widget-reviews-list-${bId}`);
      if (carousel) {
        const step = window.innerWidth <= 768 ? 280 : 390;
        carousel.scrollBy({ left: direction * step, behavior: 'smooth' });
      }
    };

    function updateWidgetCarouselUI() {
      const btnLeft = document.getElementById(`btn-left-${blockId}`);
      const btnRight = document.getElementById(`btn-right-${blockId}`);
      const indicator = document.getElementById(`carousel-indicator-${blockId}`);

      if (list && btnLeft && btnRight) {
        const scrollPos = list.scrollLeft;
        const clientSize = list.clientWidth;
        const scrollSize = list.scrollWidth;

        btnLeft.disabled = scrollPos <= 5;
        btnRight.disabled = Math.ceil(scrollPos + clientSize) >= scrollSize - 5;

        if (indicator && widgetReviewsCount > 0) {
          const cardSize = window.innerWidth <= 768 ? 280 : 390;
          const currentIndex = Math.round(scrollPos / cardSize) + 1;
          const displayIndex = Math.max(1, Math.min(currentIndex, widgetReviewsCount));
          const visibleCards = Math.max(1, Math.floor(clientSize / cardSize));
          const endIndex = Math.min(displayIndex + visibleCards - 1, widgetReviewsCount);

          if (displayIndex >= endIndex) {
            indicator.innerText = `${displayIndex} / ${widgetReviewsCount}`;
          } else {
            indicator.innerText = `${displayIndex}-${endIndex} / ${widgetReviewsCount}`;
          }
        }
      }
    }

    if (list) {
      list.addEventListener('scroll', () => { requestAnimationFrame(updateWidgetCarouselUI); });
      window.addEventListener('resize', () => { requestAnimationFrame(updateWidgetCarouselUI); });
    }

    function escapeHTML(str) {
      if (!str) return '';
      return String(str).replace(/[&<>'"]/g, tag => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;'
      }[tag]));
    }

    function clearSkeletons() {
      const titleEl = document.getElementById(`dynamic-company-name-${blockId}`);
      const exactBoxEl = document.getElementById(`exact-rating-box-${blockId}`);
      const countBadgeEl = document.getElementById(`top-review-count-badge-${blockId}`);
      const squareBoxEl = document.getElementById(`rating-square-box-${blockId}`);
      const trustBadge = document.getElementById(`trust-score-badge-${blockId}`);
      const velocityBadge = document.getElementById(`velocity-badge-${blockId}`);

      if (titleEl) titleEl.classList.remove('skeleton-anim', 'sk-title');
      if (exactBoxEl) exactBoxEl.classList.remove('skeleton-anim', 'skel-exact-rating');
      if (countBadgeEl) countBadgeEl.classList.remove('skeleton-anim', 'skel-exact-rating');
      if (squareBoxEl) squareBoxEl.classList.remove('skeleton-anim', 'skel-rating-square');
      if (trustBadge) trustBadge.classList.remove('skeleton-anim', 'skel-exact-rating');
      if (velocityBadge) velocityBadge.classList.remove('skeleton-anim', 'skel-exact-rating');
    }

    // Initialize Supabase
    const SUPABASE_URL = 'https://fdjcvpsqossuiljuadkk.supabase.co';
    const SUPABASE_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImZkamN2cHNxb3NzdWlsanVhZGtrIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzA2MDI5ODYsImV4cCI6MjA4NjE3ODk4Nn0.z2ZutYZi_oLr_wYq6LufLyU3bI3XbRuA33JD8iA5Q6o';
    const db = window.supabase.createClient(SUPABASE_URL, SUPABASE_KEY);

    /* --- UNIFIED INFO BOX LOGIC --- */
    async function loadProductInfo() {
      const { data: prodData, error: prodErr } = await db.from('products').select('*').eq('product_id', productId);
      const trustBadge = document.getElementById(`trust-score-badge-${blockId}`);
      const velocityBadge = document.getElementById(`velocity-badge-${blockId}`);
      const titleEl = document.getElementById(`dynamic-company-name-${blockId}`);
      const brandEl = document.getElementById(`top-left-brand-${blockId}`);

      clearSkeletons();

      if (!prodErr && prodData && prodData.length > 0) {
        const co = prodData[0];
        if (titleEl && co.name) titleEl.innerText = co.name;

        const { data: prodAnalytics } = await db.from('product_analytics').select('*').eq('product_id', productId).single();
        if (prodAnalytics) {
          if (trustBadge) trustBadge.style.display = 'inline-flex';
          const trustText = document.getElementById(`trust-score-text-${blockId}`);
          if (trustText) trustText.innerText = `Trust Score: ${prodAnalytics.product_trust_score || 400}`;

          if (velocityBadge) velocityBadge.style.display = 'inline-flex';
          const velocityText = document.getElementById(`velocity-text-${blockId}`);
          if (velocityText) velocityText.innerText = `+${prodAnalytics.review_velocity_30d || 0} this month`;
        } else {
          if (trustBadge) trustBadge.style.display = 'none';
          if (velocityBadge) velocityBadge.style.display = 'none';
        }

        if (co.store_id) {
          const { data: storeData } = await db.from('stores').select('domain_name').eq('store_id', co.store_id).single();
          if (storeData && storeData.domain_name && brandEl) {
            brandEl.innerText = `product from ${storeData.domain_name}`;
          }
        }
      } else {
        if (titleEl && fallbackTitle) titleEl.innerText = fallbackTitle;
        if (brandEl && fallbackDomain) brandEl.innerText = `product from ${fallbackDomain}`;
        if (trustBadge) trustBadge.style.display = 'none';
        if (velocityBadge) velocityBadge.style.display = 'none';
      }
    }

    function updateVisualRatings(ratingValue, totalReviews) {
      const formatted = ratingValue.toFixed(1);
      let activeColor = "#10B981";
      if (ratingValue === 0) activeColor = "#cbd5e1";
      else if (ratingValue < 1.5) activeColor = "#EF4444";
      else if (ratingValue < 2.5) activeColor = "#F97316";
      else if (ratingValue < 3.5) activeColor = "#F59E0B";
      else if (ratingValue < 4.5) activeColor = "#84CC16";

      const bigValEl = document.getElementById(`big-rating-val-${blockId}`);
      if (bigValEl) bigValEl.innerText = formatted;
      renderExactStars(ratingValue, `big-rating-stars-${blockId}`, 18, activeColor);

      const exactTextEl = document.getElementById(`exact-rating-text-${blockId}`);
      const exactBoxEl = document.getElementById(`exact-rating-box-${blockId}`);
      if (exactTextEl) {
        exactTextEl.innerText = formatted;
        exactTextEl.style.color = activeColor;
      }
      if (exactBoxEl) {
        exactBoxEl.style.borderColor = activeColor;
      }
      renderExactStars(ratingValue, `exact-stars-container-${blockId}`, 16, activeColor);

      const countStr = totalReviews + (totalReviews === 1 ? ' review' : ' reviews');
      const bigCountEl = document.getElementById(`big-rating-count-${blockId}`);
      const topCountEl = document.getElementById(`top-review-count-text-${blockId}`);
      if (bigCountEl) bigCountEl.innerText = countStr;
      if (topCountEl) topCountEl.innerText = countStr;
    }

    function renderExactStars(rating, containerId, size = 18, fillColor = "#10B981") {
      const container = document.getElementById(containerId);
      if (!container) return;
      container.innerHTML = '';
      let useEmpty = "#e2e8f0";
      for (let i = 1; i <= 5; i++) {
        let fillPercent = rating >= i ? 100 : (rating > i - 1 ? (rating - (i - 1)) * 100 : 0);
        const starId = `grad-${containerId}-${i}-${Math.random().toString(36).substr(2, 5)}`;
        container.innerHTML += `
          <svg width="${size}" height="${size}" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <linearGradient id="${starId}" x1="0%" y1="0%" x2="100%" y2="0%">
                <stop offset="${fillPercent}%" stop-color="${fillColor}" />
                <stop offset="${fillPercent}%" stop-color="${useEmpty}" />
              </linearGradient>
            </defs>
            <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21 12 17.27z" fill="url(#${starId})"/>
          </svg>`;
      }
    }

    function buildRatingBars(reviews) {
      const counts = { 5: 0, 4: 0, 3: 0, 2: 0, 1: 0 };
      reviews.forEach(r => { if (counts[r.rating] !== undefined) counts[r.rating]++; });
      const total = reviews.length || 1;
      const barsEl = document.getElementById(`rating-bars-${blockId}`);
      if (!barsEl) return;
      barsEl.innerHTML = '';
      [5, 4, 3, 2, 1].forEach(star => {
        const pct = reviews.length ? Math.round((counts[star] / total) * 100) : 0;
        const row = document.createElement('div');
        row.className = 'rating-bar-row';
        row.innerHTML = `<span class="rating-bar-label">${star}</span><div class="rating-bar-track"><div class="rating-bar-fill" style="width:0%" data-target="${pct}%"></div></div><span class="rating-bar-pct">${pct}%</span>`;
        barsEl.appendChild(row);
      });
      setTimeout(() => {
        barsEl.querySelectorAll('.rating-bar-fill').forEach(el => {
          el.style.width = el.dataset.target;
        });
      }, 100);
    }

    async function loadWidgetReviews() {
      let { data: reviews, error } = await db
        .from('reviews')
        .select('*')
        .eq('product_id', productId)
        .or('status.eq.approved,status.is.null')
        .order('created_at', { ascending: false })
        .limit(10);

      if (error && error.message && error.message.includes('status')) {
        const fallback = await db
          .from('reviews')
          .select('*')
          .eq('product_id', productId)
          .order('created_at', { ascending: false })
          .limit(10);
        reviews = fallback.data;
        error = fallback.error;
      }

      clearSkeletons();

      if (error || !reviews || reviews.length === 0) {
        list.innerHTML = "<div class='faithox-empty-state'>No reviews yet. Be the first to review!</div>";
        updateVisualRatings(0, 0);
        buildRatingBars([]);
        return;
      }

      widgetReviewsCount = reviews.length;
      const totalRatingSum = reviews.reduce((sum, rev) => sum + (rev.rating || 0), 0);
      updateVisualRatings((totalRatingSum / reviews.length), reviews.length);
      buildRatingBars(reviews);

      list.innerHTML = '';

      reviews.forEach(r => {
        const reviewerName = r.reviewer_name || 'Verified User';
        const initials = reviewerName.split(' ').map(n => n[0]).join('').substring(0, 2).toUpperCase();
        const date = new Date(r.created_at).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });

        const authorAvatarHtml = r.avatar_url 
          ? `<img src="${escapeHTML(r.avatar_url)}" alt="${escapeHTML(reviewerName)}" style="width: 100%; height: 100%; object-fit: cover; border-radius: 50%;">`
          : initials;

        let ratingVal = r.rating || 5;

        // 100% Matching HTML Rating Pill setup from company.html
        const starSvg = `<svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21 12 17.27z"/></svg>`;
        let starsHtml = ''; 
        for(let i=1; i<=5; i++) {
          starsHtml += `<span class="star ${i <= ratingVal ? 'filled' : ''}">${starSvg}</span>`;
        }
        let ratingPill = `<div class="rating-pill rating-${ratingVal}">${starsHtml}</div>`;

        let photoUrls = [];
        try {
          if (r.photos) {
            if (Array.isArray(r.photos)) {
              photoUrls = r.photos;
            } else if (typeof r.photos === 'string') {
              const trimmed = r.photos.trim();
              if (trimmed.startsWith('[')) {
                photoUrls = JSON.parse(trimmed);
              } else if (trimmed.startsWith('{') && trimmed.endsWith('}')) {
                photoUrls = trimmed.slice(1, -1).split(',').map(s => s.replace(/^"|"$/g, '').trim());
              } else if (trimmed.startsWith('http')) {
                photoUrls = [trimmed];
              } else {
                const extractedLinks = r.photos.match(/https?:\/\/[^\s"\]}]+/g);
                if (extractedLinks) photoUrls = extractedLinks;
              }
            }
          }
        } catch (e) {
          photoUrls = [];
        }
        photoUrls = photoUrls.filter(u => u && typeof u === 'string' && u.startsWith('http'));

        let photoHtml = '';
        if (photoUrls.length > 0) {
          let imagesHtml = '';
          if (photoUrls.length === 1) {
            imagesHtml = `<img src="${photoUrls[0]}" alt="Review photo" style="width: 100%; aspect-ratio: 1 / 1; border-radius: 8px; object-fit: cover; border: 1px solid #e2e8f0; flex-shrink: 0;">`;
          } else if (photoUrls.length === 2) {
            imagesHtml = `
              <div style="position: relative; width: 100%; aspect-ratio: 1 / 1;">
                <img src="${photoUrls[0]}" alt="Review photo 1" style="position: absolute; top: 0; left: 0; width: 85%; aspect-ratio: 1 / 1; border-radius: 8px; object-fit: cover; border: 1px solid #e2e8f0; transform: rotate(-6deg); z-index: 1;">
                <img src="${photoUrls[1]}" alt="Review photo 2" style="position: absolute; bottom: 0; right: 0; width: 85%; aspect-ratio: 1 / 1; border-radius: 8px; object-fit: cover; border: 1px solid #e2e8f0; transform: rotate(6deg); z-index: 2; box-shadow: -2px 2px 6px rgba(0,0,0,0.1);">
              </div>`;
          } else {
            imagesHtml = `
              <div style="position: relative; width: 100%; aspect-ratio: 1 / 1;">
                <img src="${photoUrls[0]}" alt="Review photo 1" style="position: absolute; top: 0; left: 0; width: 75%; aspect-ratio: 1 / 1; border-radius: 8px; object-fit: cover; border: 1px solid #e2e8f0; transform: rotate(-12deg); z-index: 1;">
                <img src="${photoUrls[1]}" alt="Review photo 2" style="position: absolute; top: 12.5%; left: 12.5%; width: 75%; aspect-ratio: 1 / 1; border-radius: 8px; object-fit: cover; border: 1px solid #e2e8f0; transform: rotate(0deg); z-index: 2; box-shadow: 0 2px 6px rgba(0,0,0,0.1);">
                <img src="${photoUrls[2]}" alt="Review photo 3" style="position: absolute; bottom: 0; right: 0; width: 75%; aspect-ratio: 1 / 1; border-radius: 8px; object-fit: cover; border: 1px solid #e2e8f0; transform: rotate(12deg); z-index: 3; box-shadow: -2px 2px 6px rgba(0,0,0,0.1);">
              </div>`;
          }
          photoHtml = `
            <div class="review-photo-container" style="display: flex; flex-direction: column; width: 30%; flex-shrink: 0; margin-top: 46px;">
              ${imagesHtml}
            </div>`;
        }

        const div = document.createElement('div');
        div.className = 'review-item-main';
        div.onclick = () => window.open(`https://www.faithox.com/company?id=${productId}`, '_blank');

        // 100% Identical card structure mapping company.html
        div.innerHTML = `
          ${r.merchant_reply ? `<span style="position: absolute; bottom: 10px; left: 24px; color: #16a34a; font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; z-index: 10; display: inline-flex; align-items: center; gap: 5px;"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 10 20 15 15 20"></polyline><path d="M4 4v7a4 4 0 0 0 4 4h12"></path></svg>Company Replied</span>` : ''}
          <div style="display: flex; width: 100%; height: 100%; gap: 15px;">
              <div style="display: flex; flex-direction: column; flex: 1; min-width: 0; height: 100%;">
                  <div style="display: flex; justify-content: space-between; align-items: flex-start; width: 100%;">
                      <div class="review-author" style="margin: 0; align-items: center;">
                          <div class="author-avatar">${authorAvatarHtml}</div>
                          <div style="display: flex; flex-direction: column; justify-content: center;">
                              <div class="author-name" style="line-height: 1.1;">${escapeHTML(reviewerName)}</div>
                              <div style="display: flex; align-items: center; gap: 2px; font-size: 11px; color: #64748b; font-weight: 700; margin-top: 3px;">
                                  ${date}
                              </div>
                          </div>
                      </div>
                      ${ratingPill}
                  </div>
                  <div class="review-content-wrapper" style="padding: 0; flex: 1; height: auto; margin-top: 12px;">
                      <p class="review-body" style="-webkit-line-clamp: 5; margin-bottom: 4px;">${escapeHTML(r.comment || '')}</p>
                  </div>
              </div>
              ${photoHtml}
          </div>
        `;
        
        list.appendChild(div);
      });

      const seeMoreBtn = document.getElementById(`see-more-link-${blockId}`);
      if (seeMoreBtn) {
        seeMoreBtn.href = `https://www.faithox.com/company?id=${productId}`;
        seeMoreBtn.style.display = 'flex';
      }

      if (reviews.length > 1) {
        const controls = document.getElementById(`carousel-controls-${blockId}`);
        if (controls) controls.style.display = 'flex';
        setTimeout(updateWidgetCarouselUI, 100);
      }
    }

    loadProductInfo();
    setTimeout(loadWidgetReviews, 150);
  }

  // 2. Smart Trigger for Storefront + Shopify Theme Editor
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initFaithoxWidget);
  } else {
    initFaithoxWidget();
  }
})();
</script>

