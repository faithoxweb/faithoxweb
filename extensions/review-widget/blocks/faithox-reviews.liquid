{
  "name": "Faithox Reviews",
  "target": "section",
  "settings": [
    {
      "type": "select",
      "id": "layout_direction",
      "label": "Desktop Column Order",
      "options": [
        {
          "value": "summary_left",
          "label": "Unified Summary Box Left / Review Cards Right"
        },
        {
          "value": "reviews_left",
          "label": "Review Cards Left / Unified Summary Box Right"
        }
      ],
      "default": "reviews_left"
    },
    {
      "type": "range",
      "id": "widget_width",
      "min": 300,
      "max": 1200,
      "step": 20,
      "default": 1200,
      "label": "Maximum Widget Width (px)"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f0f1f1"
    }
  ]
}
{% endschema %}
