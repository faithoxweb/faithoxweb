<!-- Load Supabase Library securely -->
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

<div class="faithox-widget-root" id="faithox-widget-{{ block.id }}">
    <div class="widget-wrapper">
        
        <!-- NEW PRODUCT INFO BOX SECTION -->
        <div class="hole-info-box" id="embed-info-box-{{ block.id }}">
            <div class="hole-info-text-col">
                <span id="top-left-brand-{{ block.id }}" style="font-size: 14px; font-weight: 600; color: #1e293b; z-index: 20; display: block;"></span>
                <div class="title-container"><h1 id="dynamic-company-name-{{ block.id }}" class="skeleton-anim sk-title"></h1></div>
                
                <div style="display: flex; flex-direction: column; align-items: flex-start; gap: 10px;">
                    <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
                        <div class="product-exact-rating-row skeleton-anim skel-exact-rating" id="exact-rating-box-{{ block.id }}">
                            <div id="exact-stars-container-{{ block.id }}" class="stars-container-flex"></div><span id="exact-rating-text-{{ block.id }}">0.0</span>
                        </div>
                        
                        <div class="top-review-count-badge skeleton-anim skel-exact-rating" id="top-review-count-badge-{{ block.id }}">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 5px;"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
                            <span id="top-review-count-text-{{ block.id }}">0 reviews</span>
                        </div>

                        <div class="top-review-count-badge skeleton-anim skel-exact-rating" id="trust-score-badge-{{ block.id }}" style="border-color: #3b82f6;">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#3b82f6" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 5px;"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                            <span id="trust-score-text-{{ block.id }}" style="color: #1d4ed8;">Trust Score: --</span>
                        </div>

                        <div class="top-review-count-badge skeleton-anim skel-exact-rating" id="velocity-badge-{{ block.id }}" style="border-color: #8b5cf6;">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#8b5cf6" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 5px;"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline><polyline points="17 6 23 6 23 12"></polyline></svg>
                            <span id="velocity-text-{{ block.id }}" style="color: #5b21b6;">-- recent</span>
                        </div>
                    </div>

                    <a id="dynamic-company-link-{{ block.id }}" href="#" target="_blank">
                        View product on store
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg>
                    </a>
                </div>
            </div>
            
            <div class="top-rating-square skeleton-anim skel-rating-square" id="rating-square-box-{{ block.id }}">
                <div class="top-rating-square-header">Rating Breakdown</div>
                <div class="rating-overview">
                    <div class="big-rating">
                        <div class="big-rating-val" id="big-rating-val-{{ block.id }}">—</div>
                        <div class="big-rating-stars" id="big-rating-stars-{{ block.id }}"></div>
                        <div class="big-rating-count" id="big-rating-count-{{ block.id }}">0 reviews</div>
                    </div>
                    <div class="rating-bars" id="rating-bars-{{ block.id }}"></div>
                </div>
            </div>
        </div>
        <!-- END PRODUCT INFO BOX SECTION -->

        <div class="reviews-scroll-container" id="widget-reviews-list-{{ block.id }}">
            <p style="text-align:center; color:#64748b; font-size:13px; padding: 20px; font-weight: 500;">Loading reviews...</p>
        </div>
        
        <div class="widget-footer">
            <div class="faithox-branding">Powered by Faithox</div>
            <div class="footer-actions">
                <div class="carousel-controls" id="carousel-controls-{{ block.id }}" style="display: none;">
                    <button class="scroll-btn left-btn" onclick="scrollWidgetReviews(-1, '{{ block.id }}')" id="btn-left-{{ block.id }}" disabled>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><polyline points="15 18 9 12 15 6"></polyline></svg>
                    </button>
                    <button class="scroll-btn right-btn" onclick="scrollWidgetReviews(1, '{{ block.id }}')" id="btn-right-{{ block.id }}">
