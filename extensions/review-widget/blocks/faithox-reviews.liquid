<!-- Load Supabase Library securely -->
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<div class="faithox-widget-root" id="faithox-widget-{{ block.id }}">
  <div class="widget-wrapper">
    <div class="faithox-2col-layout">

      <!-- UNIFIED SUMMARY BOX: Rating Breakdown (Top) + Product Details (Bottom) -->
      <div class="faithox-left-col">
        <div class="faithox-unified-box">

          <!-- 1. Star Rating Breakdown Section -->
          <div class="top-rating-square skeleton-anim skel-rating-square" id="rating-square-box-{{ block.id }}">
            <div class="top-rating-square-header-row">
              <span class="top-rating-square-header">Rating Breakdown</span>
              <span class="faithox-audit-mini-tag">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#10B981" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                Verified Metrics
              </span>
            </div>
            <div class="rating-overview">
              <div class="big-rating">
                <div class="big-rating-val" id="big-rating-val-{{ block.id }}">—</div>
                <div class="big-rating-stars" id="big-rating-stars-{{ block.id }}"></div>
                <div class="big-rating-count" id="big-rating-count-{{ block.id }}">0 reviews</div>
              </div>
              <div class="rating-bars" id="rating-bars-{{ block.id }}"></div>
            </div>
          </div>

          <div class="faithox-box-divider"></div>

          <!-- 2. Downside Product Details Section -->
          <div class="hole-info-box" id="embed-info-box-{{ block.id }}">
            <div class="hole-info-text-col">
              <span id="top-left-brand-{{ block.id }}" class="faithox-brand-label"></span>
              <div class="title-container">
                <h1 id="dynamic-company-name-{{ block.id }}" class="skeleton-anim sk-title">{{ product.title | escape }}</h1>
              </div>

              <div class="faithox-badges-wrapper">
                <div class="product-exact-rating-row skeleton-anim skel-exact-rating" id="exact-rating-box-{{ block.id }}">
                  <div id="exact-stars-container-{{ block.id }}" class="stars-container-flex"></div>
                  <span id="exact-rating-text-{{ block.id }}">0.0</span>
                </div>

                <div class="top-review-count-badge skeleton-anim skel-exact-rating" id="top-review-count-badge-{{ block.id }}">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 5px; flex-shrink: 0;">
                    <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
                  </svg>
                  <span id="top-review-count-text-{{ block.id }}">0 reviews</span>
                </div>

                <div class="top-review-count-badge skeleton-anim skel-exact-rating" id="trust-score-badge-{{ block.id }}" style="border-color: #3b82f6;">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#3b82f6" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 5px; flex-shrink: 0;">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                  </svg>
                  <span id="trust-score-text-{{ block.id }}" style="color: #1d4ed8;">Trust Score: --</span>
                </div>

                <div class="top-review-count-badge skeleton-anim skel-exact-rating" id="velocity-badge-{{ block.id }}" style="border-color: #8b5cf6;">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#8b5cf6" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 5px; flex-shrink: 0;">
                    <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline>
                    <polyline points="17 6 23 6 23 12"></polyline>
                  </svg>
                  <span id="velocity-text-{{ block.id }}" style="color: #5b21b6;">-- recent</span>
                </div>
              </div>
            </div>
          </div>

        </div>
      </div>

      <!-- REVIEWS COLUMN: Trust Header + Centered Review Cards + Verification Footer -->
      <div class="faithox-right-col">

        <!-- TOP TRUST & MODERATION HEADER -->
        <div class="faithox-reviews-header">
          <div class="faithox-header-titles">
            <div class="faithox-header-title-row">
              <h2 class="faithox-section-heading">Verified Customer Reviews</h2>
              <span class="faithox-live-dot" title="Live verified feed"></span>
            </div>
            <p class="faithox-section-subheading">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#10B981" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0;">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                <polyline points="9 12 11 14 15 10"></polyline>
              </svg>
              <span>Moderated by <strong>Faithox</strong> • Controlled by none</span>
            </p>
          </div>

          <div class="faithox-trust-pills">
            <div class="faithox-trust-pill">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#0f172a" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
              </svg>
              <span>Tamper-Proof</span>
            </div>
            <div class="faithox-trust-pill faithox-pill-green">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#15803d" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span>100% Unfiltered</span>
            </div>
          </div>
        </div>

        <!-- MIDDLE: EXACT 380x200 REVIEW CARDS CAROUSEL -->
        <div class="reviews-scroll-container" id="widget-reviews-list-{{ block.id }}">
          <div class="faithox-empty-state">Loading reviews...</div>
        </div>

        <!-- BOTTOM: FOOTER BAR WITH TRANSPARENCY STATEMENT & CONTROLS -->
        <div class="widget-footer">
          <div class="faithox-footer-left">
            <div class="faithox-branding-badge">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#10B981" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              </svg>
              <span>POWERED BY FAITHOX</span>
            </div>
            <span class="faithox-footer-divider">•</span>
            <span class="faithox-Zero-edit-note">Merchants cannot edit, hide, or delete authentic reviews</span>
          </div>

          <div class="footer-actions">
            <div class="carousel-controls" id="carousel-controls-{{ block.id }}" style="display: none;">
              <button type="button" class="scroll-btn left-btn" onclick="scrollWidgetReviews(-1, '{{ block.id }}')" id="btn-left-{{ block.id }}" aria-label="Previous reviews" disabled>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><polyline points="15 18 9 12 15 6"></polyline></svg>
              </button>
              <div class="carousel-indicator" id="carousel-indicator-{{ block.id }}">1 / 1</div>
              <button type="button" class="scroll-btn right-btn" onclick="scrollWidgetReviews(1, '{{ block.id }}')" id="btn-right-{{ block.id }}" aria-label="Next reviews">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><polyline points="9 18 15 12 9 6"></polyline></svg>
              </button>
            </div>
            <a id="see-more-link-{{ block.id }}" href="#" target="_blank" rel="noopener noreferrer" class="see-more-btn" style="display: none;">
              <span>Read all reviews</span>
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-left: 5px;">
                <line x1="7" y1="17" x2="17" y2="7"></line>
                <polyline points="7 7 17 7 17 17"></polyline>
              </svg>
            </a>
          </div>
        </div>

      </div>

    </div>
  </div>
</div>

<style>
/* 1. Scoped Reset */
#faithox-widget-{{ block.id }},
#faithox-widget-{{ block.id }} * {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  outline: none;
}

/* 2. Full-Viewport Breakout Wrapper */
#faithox-widget-{{ block.id }} {
  font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
  color: #1e293b;
  -webkit-font-smoothing: antialiased;
  display: block !important;
  width: 100vw !important;
  max-width: 100vw !important;
  position: relative !important;
  left: 50% !important;
  transform: translateX(-50%) !important;
  margin: 0 !important;
  padding: 0 !important;
  overflow-x: clip !important;
}

#faithox-widget-{{ block.id }} .widget-wrapper {
  display: flex;
  flex-direction: column;
  width: 100%;
  padding: 28px 5%;
  background: {{ block.settings.bg_color | default: '#f0f1f1' }};
  border: none !important;
  border-radius: 0 !important;
  box-shadow: none !important;
}

/* 3. 2-Column Main Layout */
#faithox-widget-{{ block.id }} .faithox-2col-layout {
  display: flex;
  flex-direction: {% if block.settings.layout_direction == 'reviews_left' %}row-reverse{% else %}row{% endif %};
  gap: 24px;
  align-items: stretch;
  width: 100%;
  max-width: {{ block.settings.widget_width | default: 1200 }}px;
  margin: 0 auto !important;
}

{% if block.settings.widget_width == 1200 or block.settings.widget_width == blank %}
#faithox-widget-{{ block.id }} .faithox-2col-layout {
  max-width: 100%;
}
{% endif %}

#faithox-widget-{{ block.id }} .faithox-left-col {
  width: 360px;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
}

#faithox-widget-{{ block.id }} .faithox-right-col {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: 14px;
}

/* 4. Unified Box (Rating Breakdown + Product Details) */
#faithox-widget-{{ block.id }} .faithox-unified-box {
  background: #fdfdfd;
  border-radius: 32px;
  padding: 24px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: 18px;
  width: 100%;
  height: 100%;
  box-shadow: 0 2px 12px rgba(15, 23, 42, 0.03);
}

#faithox-widget-{{ block.id }} .faithox-box-divider {
  width: 100%;
  height: 1px;
  background: #e2e8f0;
  flex-shrink: 0;
}

/* Top Section inside Unified Box: Rating Breakdown */
#faithox-widget-{{ block.id }} .top-rating-square {
  width: 100%;
  background: transparent;
  border-radius: 12px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 0;
  flex-shrink: 0;
}

#faithox-widget-{{ block.id }} .top-rating-square-header-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12px;
}

#faithox-widget-{{ block.id }} .top-rating-square-header {
  font-size: 11px;
  font-weight: 800;
  color: #64748b;
  text-transform: uppercase;
  letter-spacing: 0.6px;
}

#faithox-widget-{{ block.id }} .faithox-audit-mini-tag {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  font-size: 10px;
  font-weight: 700;
  color: #059669;
  background: #ecfdf5;
  padding: 3px 8px;
  border-radius: 20px;
  letter-spacing: 0.2px;
}

#faithox-widget-{{ block.id }} .rating-overview {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 20px;
  width: 100%;
}

#faithox-widget-{{ block.id }} .big-rating {
  text-align: center;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 96px;
}

#faithox-widget-{{ block.id }} .big-rating-val {
  font-size: 40px;
  font-weight: 800;
  color: #2a2a2a;
  line-height: 1;
  letter-spacing: -1.5px;
  transition: color 0.3s ease;
}

#faithox-widget-{{ block.id }} .big-rating-stars {
  font-size: 16px;
  letter-spacing: 2px;
  margin: 6px 0 4px;
  display: flex;
  justify-content: center;
  gap: 2px;
}

#faithox-widget-{{ block.id }} .big-rating-count {
  font-size: 11px;
  color: #94a3b8;
  font-weight: 600;
}

#faithox-widget-{{ block.id }} .rating-bars {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6px;
  min-width: 0;
}

#faithox-widget-{{ block.id }} .rating-bar-row {
  display: flex;
  align-items: center;
  gap: 8px;
}

#faithox-widget-{{ block.id }} .rating-bar-label {
  font-size: 11px;
  font-weight: 700;
  color: #64748b;
  width: 12px;
  text-align: right;
  flex-shrink: 0;
}

#faithox-widget-{{ block.id }} .rating-bar-track {
  flex: 1;
  height: 6px;
  background: #e2e8f0;
  border-radius: 10px;
  overflow: hidden;
}

#faithox-widget-{{ block.id }} .rating-bar-fill {
  height: 100%;
  background: #10B981;
  border-radius: 10px;
  transition: width 1s cubic-bezier(0.4, 0, 0.2, 1);
}

#faithox-widget-{{ block.id }} .rating-bar-pct {
  font-size: 10px;
  font-weight: 700;
  color: #94a3b8;
  width: 28px;
  text-align: right;
  flex-shrink: 0;
}

/* Bottom Section inside Unified Box: Product Info & Badges */
#faithox-widget-{{ block.id }} .hole-info-box {
  background: transparent;
  border-radius: 0;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  padding: 0;
  margin: 0;
  width: 100%;
  box-shadow: none;
}

#faithox-widget-{{ block.id }} .hole-info-text-col {
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  gap: 10px;
  width: 100%;
  min-width: 0;
}

#faithox-widget-{{ block.id }} .faithox-brand-label {
  font-size: 12px;
  font-weight: 600;
  color: #64748b;
  display: block;
  line-height: 1.2;
}

#faithox-widget-{{ block.id }} .faithox-brand-label:empty {
  display: none;
}

#faithox-widget-{{ block.id }} .title-container {
  width: 100%;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
}

#faithox-widget-{{ block.id }} h1.skeleton-anim {
  margin: 0;
  padding: 0;
}

#faithox-widget-{{ block.id }} h1:not(.skeleton-anim) {
  font-size: 17px;
  font-weight: 700;
  color: #1e293b;
  background: transparent;
  margin: 0;
  padding: 0;
  width: 100%;
  line-height: 1.35;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
  word-break: break-word;
}

#faithox-widget-{{ block.id }} .faithox-badges-wrapper {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
  margin-top: 2px;
}

#faithox-widget-{{ block.id }} .product-exact-rating-row {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: #fdfdfd;
  border: 2px solid #e2e8f0;
  padding: 0 8px;
  height: 28px;
  margin: 0;
  border-radius: 9px;
  width: fit-content;
  transition: border-color 0.3s ease;
}

#faithox-widget-{{ block.id }} .stars-container-flex {
  display: flex;
  gap: 3px;
  align-items: center;
  justify-content: center;
}

#faithox-widget-{{ block.id }} [id^="exact-rating-text-"] {
  font-size: 14px;
  font-weight: 800;
  color: #94a3b8;
  line-height: 1;
  transition: color 0.3s ease;
}

#faithox-widget-{{ block.id }} .top-review-count-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 28px;
  padding: 0 10px;
  background: #fdfdfd;
  border-radius: 9px;
  color: #475569;
  font-size: 12px;
  font-weight: 700;
  border: 2px solid #e2e8f0;
  transition: all 0.3s ease;
  white-space: nowrap;
}

/* 5. Skeleton Loader Styles */
#faithox-widget-{{ block.id }} .skeleton-anim {
  background: #e2e8f0;
  background-image: linear-gradient(90deg, #e2e8f0 0px, #f8fafc 40px, #e2e8f0 80px);
  background-size: 600px;
  animation: shine-lines 1.6s infinite linear;
  border-radius: 8px;
  pointer-events: none;
}

@keyframes shine-lines {
  0% { background-position: -300px; }
  100% { background-position: 300px; }
}

#faithox-widget-{{ block.id }} .sk-title {
  width: 100%;
  height: 36px;
  border-radius: 8px;
  color: transparent !important;
}

#faithox-widget-{{ block.id }} .skel-exact-rating {
  width: 115px !important;
  height: 28px !important;
  border-color: transparent !important;
  box-shadow: none !important;
  padding: 0 !important;
}

#faithox-widget-{{ block.id }} .skel-exact-rating > * {
  opacity: 0 !important;
  visibility: hidden !important;
}

#faithox-widget-{{ block.id }} .skel-rating-square {
  min-height: 108px;
  border-color: transparent !important;
  box-shadow: none !important;
}

#faithox-widget-{{ block.id }} .skel-rating-square > * {
  opacity: 0 !important;
  visibility: hidden !important;
}

/* 6. Right Column Top Header (Trust & Moderation Banner) */
#faithox-widget-{{ block.id }} .faithox-reviews-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  background: #fdfdfd;
  padding: 14px 22px;
  border-radius: 22px;
  box-shadow: 0 2px 12px rgba(15, 23, 42, 0.02);
  flex-shrink: 0;
}

#faithox-widget-{{ block.id }} .faithox-header-titles {
  display: flex;
  flex-direction: column;
  gap: 3px;
}

#faithox-widget-{{ block.id }} .faithox-header-title-row {
  display: flex;
  align-items: center;
  gap: 8px;
}

#faithox-widget-{{ block.id }} .faithox-section-heading {
  font-size: 16px !important;
  font-weight: 800 !important;
  color: #1e293b !important;
  letter-spacing: -0.3px !important;
  line-height: 1.2 !important;
  margin: 0 !important;
}

#faithox-widget-{{ block.id }} .faithox-live-dot {
  width: 7px;
  height: 7px;
  background: #10B981;
  border-radius: 50%;
  display: inline-block;
  box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.18);
}

#faithox-widget-{{ block.id }} .faithox-section-subheading {
  display: flex;
  align-items: center;
  gap: 5px;
  font-size: 12px !important;
  font-weight: 500 !important;
  color: #64748b !important;
  line-height: 1.3 !important;
  margin: 0 !important;
}

#faithox-widget-{{ block.id }} .faithox-section-subheading strong {
  font-weight: 700;
  color: #0f172a;
}

#faithox-widget-{{ block.id }} .faithox-trust-pills {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-shrink: 0;
}

#faithox-widget-{{ block.id }} .faithox-trust-pill {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  height: 28px;
  padding: 0 11px;
  background: #f8fafc;
  border: 1.5px solid #e2e8f0;
  border-radius: 10px;
  font-size: 11px;
  font-weight: 700;
  color: #334155;
  white-space: nowrap;
}

#faithox-widget-{{ block.id }} .faithox-trust-pill.faithox-pill-green {
  background: #f0fdf4;
  border-color: #bbf7d0;
  color: #15803d;
}

/* 7. Review Cards Carousel (Centered with Equal Vertical Space) */
#faithox-widget-{{ block.id }} .reviews-scroll-container {
  flex: 1;
  overflow-x: auto;
  overflow-y: hidden;
  display: flex;
  flex-direction: row;
  align-items: center; /* Leaves equal gap above and below the 200px cards */
  padding: 4px 0;
  scroll-snap-type: x mandatory;
  scrollbar-width: none;
  -ms-overflow-style: none;
}

#faithox-widget-{{ block.id }} .reviews-scroll-container::-webkit-scrollbar {
  display: none;
}

#faithox-widget-{{ block.id }} .faithox-empty-state {
  width: 100%;
  height: 200px;
  background: #fdfdfd;
  border-radius: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  color: #64748b;
  font-size: 13px;
  padding: 24px;
  font-weight: 500;
}

/* 100% Identical Review Cards from company.html */
#faithox-widget-{{ block.id }} .review-item-main { 
  background: #fdfdfd;
  border-radius: 32px;
  padding: 24px;
  width: 380px;
  height: 200px;
  flex-shrink: 0;
  transition: all 0.1s ease;
  display: flex;
  flex-direction: column;
  gap: 12px;
  cursor: pointer;
  text-align: left;
  position: relative;
  overflow: hidden;
  border: 2px solid transparent;
  scroll-snap-align: start;
  margin-right: 10px; 
}

#faithox-widget-{{ block.id }} .review-item-main:last-child {
  margin-right: 0;
}

#faithox-widget-{{ block.id }} .review-item-main:hover {
  background: #dcdcdc;
}

#faithox-widget-{{ block.id }} .rating-pill {
  position: absolute;
  top: 24px;
  right: 24px;
  display: inline-flex;
  align-items: center;
  gap: 4px;
  padding: 0 8px;
  height: 28px;
  border-radius: 9px;
  background: #fdfdfd;
  border: 2px solid #19bb42;
  width: fit-content;
  margin: 0;
  flex-shrink: 0;
  z-index: 5;
}
