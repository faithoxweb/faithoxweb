<!-- Load Supabase Library securely -->
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

<div class="faithox-widget-root" id="faithox-widget-{{ block.id }}">
    <div class="widget-wrapper">
        <div class="reviews-scroll-container" id="widget-reviews-list-{{ block.id }}">
            <p style="text-align:center; color:#64748b; font-size:13px; padding: 20px; font-weight: 500;">Loading reviews...</p>
        </div>
        
        <div class="widget-footer">
            <div class="faithox-branding">Powered by Faithox</div>
            <div class="footer-actions">
                <div class="carousel-controls" id="carousel-controls-{{ block.id }}" style="display: none;">
                    <button class="scroll-btn left-btn" onclick="scrollWidgetReviews(-1, '{{ block.id }}')" id="btn-left-{{ block.id }}" disabled>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><polyline points="15 18 9 12 15 6"></polyline></svg>
                    </button>
                    <button class="scroll-btn right-btn" onclick="scrollWidgetReviews(1, '{{ block.id }}')" id="btn-right-{{ block.id }}">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><polyline points="9 18 15 12 9 6"></polyline></svg>
                    </button>
                </div>
                <a id="see-more-link-{{ block.id }}" href="#" target="_blank" class="see-more-btn" style="display: none;">
                    Read all reviews
                </a>
            </div>
        </div>
    </div>
</div>

<style>
/* 1. Reset scoped ONLY to your widget to prevent Shopify theme bleed */
#faithox-widget-{{ block.id }}, 
#faithox-widget-{{ block.id }} * { 
    margin: 0; 
    padding: 0; 
    box-sizing: border-box; 
    outline: none; 
}

/* 2. Base styles applied to the root wrapper using your Shopify Settings */
#faithox-widget-{{ block.id }} { 
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif; 
    color: #1e293b;
    -webkit-font-smoothing: antialiased;
    width: 100%;
    margin: 0 auto;
    max-width: {{ block.settings.widget_width }}px;
    display: block;
}

#faithox-widget-{{ block.id }} .widget-wrapper {
    display: flex;
    flex-direction: column;
    width: 100%;
    padding: 20px; 
    background: {{ block.settings.bg_color }};
    border: 2px solid #2a2a2a; 
    border-radius: 16px; 
    box-shadow: 0 4px 15px rgba(0,0,0,0.05); 
    overflow: hidden; 
}

#faithox-widget-{{ block.id }} .reviews-scroll-container {
    flex: 1;
    overflow-x: auto;
    overflow-y: hidden;
    display: flex;
    flex-direction: row; 
    gap: 10px; 
    padding-bottom: 8px;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -ms-overflow-style: none; 
}
#faithox-widget-{{ block.id }} .reviews-scroll-container::-webkit-scrollbar { display: none; }

#faithox-widget-{{ block.id }} .review-item-main { 
    background: #fdfdfd; 
    border-radius: 32px; 
    padding: 24px; 
    width: 380px; 
    height: 200px; 
    flex-shrink: 0;
    transition: all 0.1s ease; 
    display: flex; 
    flex-direction: column; 
    gap: 12px; 
    cursor: pointer; 
    text-align: left;
    position: relative; 
    overflow: hidden; 
    scroll-snap-align: start; 
    border: 1px solid #e2e8f0;
}
#faithox-widget-{{ block.id }} .review-item-main:hover { background: #f8fafc; }

#faithox-widget-{{ block.id }} .rating-pill { 
    position: absolute; 
    top: 24px; 
    right: 24px; 
    display: inline-flex; 
    align-items: center; 
    gap: 4px; 
    padding: 0 8px; 
    height: 28px; 
    border-radius: 9px; 
    background: #fdfdfd; 
    border: 2px solid #19bb42; 
    width: fit-content; 
    margin: 0; 
    flex-shrink: 0; 
}
#faithox-widget-{{ block.id }} .rating-pill .star { width: 20px; height: 20px; color: #e2e8f0; display: inline-flex; align-items: center; justify-content: center; }
#faithox-widget-{{ block.id }} .rating-pill .star svg { width: 100%; height: 100%; fill: currentColor; }
#faithox-widget-{{ block.id }} .rating-pill.rating-5 { border-color: #10B981; } #faithox-widget-{{ block.id }} .rating-pill.rating-5 .filled { color: #10B981; }
#faithox-widget-{{ block.id }} .rating-pill.rating-4 { border-color: #84CC16; } #faithox-widget-{{ block.id }} .rating-pill.rating-4 .filled { color: #84CC16; }
#faithox-widget-{{ block.id }} .rating-pill.rating-3 { border-color: #F59E0B; } #faithox-widget-{{ block.id }} .rating-pill.rating-3 .filled { color: #F59E0B; }
#faithox-widget-{{ block.id }} .rating-pill.rating-2 { border-color: #F97316; } #faithox-widget-{{ block.id }} .rating-pill.rating-2 .filled { color: #F97316; }
#faithox-widget-{{ block.id }} .rating-pill.rating-1 { border-color: #EF4444; } #faithox-widget-{{ block.id }} .rating-pill.rating-1 .filled { color: #EF4444; }

#faithox-widget-{{ block.id }} .review-content-wrapper { flex: 1; display: flex; flex-direction: column; overflow: hidden; }
#faithox-widget-{{ block.id }} .review-author { display: flex; align-items: center; gap: 8px; margin-bottom: 6px; flex-shrink: 0; }
#faithox-widget-{{ block.id }} .author-avatar { width: 32px; height: 32px; border-radius: 50%; background: #242424; color: #f2f2f2; display: flex; align-items: center; justify-content: center; font-size: 11px; font-weight: 800; flex-shrink: 0; overflow: hidden; }
#faithox-widget-{{ block.id }} .author-name { font-size: 15px; font-weight: 700; color: #242424; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
#faithox-widget-{{ block.id }} .review-body { font-size: 14px; color: #242424; line-height: 1.5; margin-bottom: 4px; display: -webkit-box; -webkit-line-clamp: 5; -webkit-box-orient: vertical; overflow: hidden; text-overflow: ellipsis; }

/* Widget Footer */
#faithox-widget-{{ block.id }} .widget-footer { display: flex; align-items: center; justify-content: space-between; padding-top: 12px; background: transparent; margin-top: auto; }
#faithox-widget-{{ block.id }} .faithox-branding { font-size: 10px; font-weight: 600; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.5px; }
#faithox-widget-{{ block.id }} .footer-actions { display: flex; align-items: center; gap: 12px; }
#faithox-widget-{{ block.id }} .carousel-controls { display: flex; align-items: center; gap: 8px; }
#faithox-widget-{{ block.id }} .scroll-btn { width: 32px; height: 32px; border-radius: 50%; background: #fdfdfd; border: 1px solid #dcdcdc; display: flex; align-items: center; justify-content: center; cursor: pointer; color: #2a2a2a; transition: all 0.2s ease; }
#faithox-widget-{{ block.id }} .scroll-btn:hover:not(:disabled) { background: #dcdcdc; }
#faithox-widget-{{ block.id }} .scroll-btn:disabled { opacity: 0.35; cursor: not-allowed; }
#faithox-widget-{{ block.id }} .scroll-btn svg { width: 18px; height: 18px; stroke-width: 3; }
#faithox-widget-{{ block.id }} .see-more-btn { display: flex; align-items: center; justify-content: center; background: #2a2a2a; color: #ffffff; border: none; padding: 0 16px; height: 32px; border-radius: 8px; cursor: pointer; font-weight: 600; font-size: 12px; text-decoration: none; }
</style>

<script>
document.addEventListener("DOMContentLoaded", function() {
    const productId = "{{ product.id }}";
    const blockId = "{{ block.id }}";
    const list = document.getElementById(`widget-reviews-list-${blockId}`);

    if (!productId) {
        list.innerHTML = "<p style='text-align:center; color:#ef4444; font-size:13px; padding: 20px; font-weight: 600;'>Error: Product ID missing.</p>";
        return;
    }

    // Carousel Global Functions
    window.scrollWidgetReviews = function(direction, bId) {
        const carousel = document.getElementById(`widget-reviews-list-${bId}`);
        if(carousel) carousel.scrollBy({ left: direction * 1170, behavior: 'smooth' });
    };

    function updateWidgetCarouselUI() {
        const btnLeft = document.getElementById(`btn-left-${blockId}`);
        const btnRight = document.getElementById(`btn-right-${blockId}`);
        if (list && btnLeft && btnRight) {
            btnLeft.disabled = list.scrollLeft <= 5;
            btnRight.disabled = Math.ceil(list.scrollLeft + list.clientWidth) >= list.scrollWidth - 5;
        }
    }

    list.addEventListener('scroll', () => { requestAnimationFrame(updateWidgetCarouselUI); });

    function escapeHTML(str) {
        if (!str) return '';
        return String(str).replace(/[&<>'"]/g, tag => ({
            '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;'
        }[tag]));
    }

    // Initialize Supabase
    const SUPABASE_URL = 'https://fdjcvpsqossuiljuadkk.supabase.co';
    const SUPABASE_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImZkamN2cHNxb3NzdWlsanVhZGtrIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzA2MDI5ODYsImV4cCI6MjA4NjE3ODk4Nn0.z2ZutYZi_oLr_wYq6LufLyU3bI3XbRuA33JD8iA5Q6o';
    const db = window.supabase.createClient(SUPABASE_URL, SUPABASE_KEY);

    async function loadWidgetReviews() {
        const { data: reviews, error } = await db
            .from('reviews')
            .select('*')
            .eq('product_id', productId) 
            .order('created_at', { ascending: false })
            .limit(10);

        if (error || !reviews || reviews.length === 0) {
            list.innerHTML = "<p style='text-align:center; color:#64748b; font-size:13px; padding: 20px; font-weight: 500;'>No reviews yet. Be the first to review!</p>";
            return;
        }

        list.innerHTML = '';
        const starSvg = `<svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21 12 17.27z"/></svg>`;

        reviews.forEach(r => {
            const reviewerName = r.reviewer_name || 'Verified User';
            const initials = reviewerName.split(' ').map(n => n[0]).join('').substring(0, 2).toUpperCase();
            const date = new Date(r.created_at).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
            
            const avatarUrl = r.avatar_url;
            const authorAvatarHtml = avatarUrl 
                ? `<img src="${escapeHTML(avatarUrl)}" style="width: 100%; height: 100%; object-fit: cover; border-radius: 50%;">` 
                : initials;

            let starsHtml = '';
            for(let i = 1; i <= 5; i++) { 
                starsHtml += `<span class="star ${i <= (r.rating || 5) ? 'filled' : ''}">${starSvg}</span>`; 
            }

            // Photo Parsing Logic
            let photoUrls = [];
            try {
                if (r.photos) {
                    if (Array.isArray(r.photos)) {
                        photoUrls = r.photos;
                    } else if (typeof r.photos === 'string') {
                        const trimmed = r.photos.trim();
                        if (trimmed.startsWith('[')) {
                            photoUrls = JSON.parse(trimmed);
                        } else if (trimmed.startsWith('{') && trimmed.endsWith('}')) {
                            photoUrls = trimmed.slice(1, -1).split(',').map(s => s.replace(/^"|"$/g, '').trim());
                        } else if (trimmed.startsWith('http')) {
                            photoUrls = [trimmed];
                        } else {
                            const extractedLinks = r.photos.match(/https?:\/\/[^\s"\]}]+/g);
                            if (extractedLinks) photoUrls = extractedLinks;
                        }
                    }
                }
            } catch (e) {
                photoUrls = [];
            }
            photoUrls = photoUrls.filter(u => u && typeof u === 'string' && u.startsWith('http'));

            let photoHtml = '';
            if (photoUrls.length > 0) {
                let imagesHtml = '';
                if (photoUrls.length === 1) {
                    imagesHtml = `<img src="${photoUrls[0]}" style="width: 100%; aspect-ratio: 1 / 1; border-radius: 8px; object-fit: cover; border: 1px solid #e2e8f0; flex-shrink: 0;">`;
                } else if (photoUrls.length === 2) {
                    imagesHtml = `
                    <div style="position: relative; width: 100%; aspect-ratio: 1 / 1;">
                        <img src="${photoUrls[0]}" style="position: absolute; top: 0; left: 0; width: 85%; aspect-ratio: 1 / 1; border-radius: 8px; object-fit: cover; border: 1px solid #e2e8f0; transform: rotate(-6deg); z-index: 1;">
                        <img src="${photoUrls[1]}" style="position: absolute; bottom: 0; right: 0; width: 85%; aspect-ratio: 1 / 1; border-radius: 8px; object-fit: cover; border: 1px solid #e2e8f0; transform: rotate(6deg); z-index: 2; box-shadow: -2px 2px 6px rgba(0,0,0,0.1);">
                    </div>`;
                } else {
                    imagesHtml = `
                    <div style="position: relative; width: 100%; aspect-ratio: 1 / 1;">
                        <img src="${photoUrls[0]}" style="position: absolute; top: 0; left: 0; width: 75%; aspect-ratio: 1 / 1; border-radius: 8px; object-fit: cover; border: 1px solid #e2e8f0; transform: rotate(-12deg); z-index: 1;">
                        <img src="${photoUrls[1]}" style="position: absolute; top: 12.5%; left: 12.5%; width: 75%; aspect-ratio: 1 / 1; border-radius: 8px; object-fit: cover; border: 1px solid #e2e8f0; transform: rotate(0deg); z-index: 2; box-shadow: 0 2px 6px rgba(0,0,0,0.1);">
                        <img src="${photoUrls[2]}" style="position: absolute; bottom: 0; right: 0; width: 75%; aspect-ratio: 1 / 1; border-radius: 8px; object-fit: cover; border: 1px solid #e2e8f0; transform: rotate(12deg); z-index: 3; box-shadow: -2px 2px 6px rgba(0,0,0,0.1);">
                    </div>`;
                }
                photoHtml = `
                <div style="display: flex; flex-direction: column; width: 30%; flex-shrink: 0; margin-top: 46px;">
                    ${imagesHtml}
                </div>`;
            }

            const div = document.createElement('div');
            div.className = 'review-item-main';
            div.onclick = () => window.open(`https://www.faithox.com/company?id=${productId}`, '_blank');
            
            div.innerHTML = `
                <div style="display: flex; width: 100%; height: 100%; gap: 15px;">
                    <div style="display: flex; flex-direction: column; flex: 1; min-width: 0; height: 100%;">
                        <div style="display: flex; justify-content: space-between; align-items: flex-start; width: 100%;">
                            <div class="review-author" style="margin: 0; align-items: center;">
                                <div class="author-avatar">${authorAvatarHtml}</div>
                                <div style="display: flex; flex-direction: column; justify-content: center;">
                                    <div class="author-name" style="line-height: 1.1;">${escapeHTML(reviewerName)}</div>
                                    <div style="display: flex; align-items: center; gap: 2px; font-size: 11px; color: #64748b; font-weight: 700; margin-top: 3px;">${date}</div>
                                </div>
                            </div>
                            <div class="rating-pill rating-${r.rating || 5}">${starsHtml}</div>
                        </div>
                        <div class="review-content-wrapper" style="padding: 0; flex: 1; height: auto; margin-top: 12px;">
                            <p class="review-body" style="-webkit-line-clamp: 5; margin-bottom: 4px;">${escapeHTML(r.comment || '')}</p>
                        </div>
                    </div>
                    ${photoHtml}
                </div>
            `;
            list.appendChild(div);
        });

        const seeMoreBtn = document.getElementById(`see-more-link-${blockId}`);
        seeMoreBtn.href = `https://www.faithox.com/company?id=${productId}`;
        seeMoreBtn.style.display = 'flex';
        
        if (reviews.length > 1) {
            document.getElementById(`carousel-controls-${blockId}`).style.display = 'flex';
            setTimeout(updateWidgetCarouselUI, 100);
        }
    }
    
    setTimeout(loadWidgetReviews, 150);
});
</script>

{% schema %}
{
  "name": "Faithox Reviews",
  "target": "section",
  "settings": [
    {
      "type": "range",
      "id": "widget_width",
      "min": 300,
      "max": 1200,
      "step": 20,
      "default": 1200,
      "label": "Maximum Widget Width (px)"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f0f1f1"
    }
  ]
}
{% endschema %}
